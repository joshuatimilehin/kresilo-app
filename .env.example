# Kresilo prototype — server-side runtime configuration.
# PLACEHOLDERS ONLY. Never commit a real credential. Never reference these from
# src/ (the client bundle is public); these are read only inside server/.

# Bearer token for POST {OCTO_BASE_URL}/api/workspaces/<fixed workspace id>/query
# The workspace id is a constant in server/utils/octoClient.ts
# (4a3b41e7-2e43-4485-9167-29426d53ccba) and is deliberately NOT configurable,
# so no caller can point this app at another workspace.
#
# Empty (the default here) means storage is unavailable: /api/session answers
# 503 STORAGE_SETUP_REQUIRED. The creative workspace reports unavailable storage;
# it never claims a local in-memory fallback is saved. The legacy Studio API
# remains available for compatibility.
OCTO_API_KEY=

OCTO_BASE_URL=https://octodb.design-bakery.com

# Only this schema may be queried; the server guard rejects anything else,
# including a different value here. Migrations are additive and run by the
# outer agent, never by this app.
KRESILO_SCHEMA=kresilo_demo

# Guest session cookie. Only the SHA-256 of the token is stored in the database.
KRESILO_COOKIE_NAME=kresilo_guest
# auto = secure unless the request host is localhost
KRESILO_COOKIE_SECURE=auto

# Guest session lifetime. An expired token is rotated to a fresh guest and a
# fresh private project; it is never renewed in place.
KRESILO_SESSION_TTL_HOURS=720

# Abuse limits for this bounded prototype
KRESILO_RATE_LIMIT_PER_MINUTE=60
KRESILO_MAX_BODY_BYTES=16384

# Optional Copilot model. Empty (the default) keeps the deterministic rules and
# the UI says "no model called". With a key, proposal.create asks this model for
# a draft that is validated against the project's own references; a malformed
# answer falls back to the rules. The key is read only in server/.
INFERHUB_API_KEY=
INFERHUB_BASE_URL=https://api.inferhub.dev/v1
COPILOT_MODEL=cb/deepseek-v4.1-flash

# Clean creative workspace assistant. Model access remains server-only.
INFERHUB_OMNI_MODEL=ali/qwen3.8-omni-flash

# Optional installed Chrome binary for local MP4 rendering. An empty value lets
# HyperFrames manage its browser. Keep host-specific paths in ignored .env only.
HYPERFRAMES_BROWSER_PATH=

# Optional Google Web application client. No sign-in claim until tested.
# Register the exact hosted callback in Google Cloud. For local testing use
# http://localhost:4173/api/auth/google/callback as a second registered URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://kresilo.design-bakery.com/api/auth/google/callback
